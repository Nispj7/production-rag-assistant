# Application Config
APP_NAME="AI Knowledge Assistant"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Logging Config
LOG_LEVEL="INFO"

# OpenAI API Config
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL_NAME="gpt-4o"
EMBEDDING_MODEL_NAME="text-embedding-3-small"

# Storage Configuration
UPLOAD_DIR="./data/uploads"
VECTOR_STORE_DIR="./data/vectorstore"
VECTOR_DB_TYPE="chromadb" # Supports: 'faiss', 'chromadb' (for future extension)
MODEL_PROVIDER="local" # local or openai
